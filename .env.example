# Copie este arquivo para ".env" na raiz (compartilhado por dev local via dotenv)
# e/ou para apps/api/.env — nunca faça commit do ".env" real.

# --- Banco de dados (packages/database, apps/api) ---
DATABASE_URL="postgresql://aritech:aritech@localhost:5432/aritech_dev?schema=public"

# --- Autenticação (apps/api) ---
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_REFRESH_TTL="7d"

# --- API (apps/api) ---
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"

# --- Armazenamento de documentos (apps/api) ---
# "local" usa disco local em apps/api/storage (apenas dev).
# Troque para um adapter S3-compatible (S3, R2, MinIO) em homologação/produção.
DOCUMENT_STORAGE_DRIVER="local"
DOCUMENT_STORAGE_LOCAL_PATH="./storage"

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
