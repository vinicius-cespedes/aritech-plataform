generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency { BRL USD EUR }
enum RecordStatus { ACTIVE INACTIVE }
enum FinancialAccountType { CHECKING SAVINGS CASH INVESTMENT PAYMENT DIGITAL_WALLET INTERNATIONAL OTHER }
enum FinancialAccountStatus { ACTIVE INACTIVE CLOSED }
enum ManagementAccountNature { DEBIT CREDIT NEUTRAL }
enum EconomicNature { OPERATING_REVENUE DIRECT_COST OPERATING_EXPENSE FINANCIAL_INCOME FINANCIAL_EXPENSE TAX INVESTMENT FINANCING EQUITY TRANSFER ADJUSTMENT }
enum CostBehavior { FIXED VARIABLE SEMI_VARIABLE CONTEXT_DEPENDENT NOT_APPLICABLE }
enum CostDirectness { DIRECT INDIRECT CONTEXT_DEPENDENT NOT_APPLICABLE }
enum CounterpartyType { CUSTOMER SUPPLIER EMPLOYEE GOVERNMENT BANK PARTNER OTHER }
enum DocumentType { INVOICE SERVICE_INVOICE PRODUCT_INVOICE RECEIPT CONTRACT TAX_GUIDE PAYROLL PURCHASE_ORDER OTHER }
enum PayableSourceType { PURCHASE_ORDER SUPPLIER_INVOICE CONTRACT PAYROLL TAX EXPENSE_REIMBURSEMENT LOAN RENT MANUAL_ENTRY OTHER }
enum PayableObligationType { SUPPLIER_PAYMENT SALARY SALARY_ADVANCE VACATION THIRTEENTH_SALARY REIMBURSEMENT BENEFIT TERMINATION PRO_LABORE TAX BANK_FEE LOAN RENT OTHER }
enum ReceivableSourceType { CONTRACT BILLING_SCHEDULE MEASUREMENT SALES_ORDER SERVICE_INVOICE PRODUCT_INVOICE ADVANCE_REQUEST MANUAL_ENTRY OTHER }
enum PayableStatus { DRAFT PENDING_APPROVAL APPROVED OPEN PARTIALLY_SETTLED SETTLED CANCELLED }
enum PayableApprovalDecision { APPROVED REJECTED INVALIDATED }
enum PaymentOrigin { MANUAL RECONCILIATION }
enum PayableInstallmentStatus { OPEN PARTIALLY_SETTLED SETTLED CANCELLED }
enum ReceivableStatus { DRAFT PENDING_APPROVAL APPROVED OPEN PARTIALLY_SETTLED SETTLED CANCELLED WRITTEN_OFF }
enum ReceivableInstallmentStatus { OPEN PARTIALLY_SETTLED SETTLED CANCELLED WRITTEN_OFF }
enum PaymentMethod { PIX BANK_TRANSFER BOLETO CREDIT_CARD DEBIT_CARD CASH DIRECT_DEBIT CHECK OTHER }
enum SettlementStatus { PENDING CONFIRMED RECONCILED REVERSED CANCELLED }
enum FinancialPeriodStatus { OPEN CLOSING CLOSED REOPENED }
enum BankTransactionDirection { CREDIT DEBIT }
enum BankTransactionSource { MANUAL OFX_IMPORT CSV_IMPORT BANK_API OPEN_FINANCE SYSTEM_GENERATED }
enum BankStatementSource { OFX_IMPORT CSV_IMPORT BANK_API OPEN_FINANCE }
enum BankTransactionStatus { PENDING POSTED REVERSED IGNORED }
enum ReconciliationStatus { UNRECONCILED SUGGESTED PARTIALLY_RECONCILED RECONCILED DIVERGENT }
enum BankStatementImportStatus { PENDING PROCESSING COMPLETED COMPLETED_WITH_ERRORS FAILED CANCELLED }
enum BankReconciliationStatus { OPEN IN_PROGRESS COMPLETED REOPENED CANCELLED }
enum ReconciliationMatchType { AUTOMATIC MANUAL RULE_BASED }
enum ReconciliationTargetType { PAYMENT RECEIPT TRANSFER BANK_FEE FINANCIAL_INCOME ADVANCE OTHER }
enum ReconciliationMatchStatus { ACTIVE REVERSED }
enum FinancialTransferStatus { DRAFT CONFIRMED RECONCILED REVERSED CANCELLED }
enum FinancialAllocationSourceType { PAYABLE RECEIVABLE }

model PaymentTerm {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(160)
  description String? @db.Text
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  rules PaymentTermInstallmentRule[]
  suppliers Supplier[]
  payables Payable[]
  @@map("payment_terms")
}
model PaymentTermInstallmentRule {
  id String @id @default(uuid()) @db.Uuid
  paymentTermId String @db.Uuid @map("payment_term_id")
  sequence Int
  daysAfterBase Int @map("days_after_base")
  percentage Decimal @db.Decimal(9,6)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  paymentTerm PaymentTerm @relation(fields:[paymentTermId],references:[id],onDelete:Cascade)
  @@unique([paymentTermId,sequence])
  @@index([paymentTermId])
  @@map("payment_term_installment_rules")
}
model Supplier {
  id String @id @default(uuid()) @db.Uuid
  legalEntityId String @db.Uuid @map("legal_entity_id")
  legalName String? @db.VarChar(200) @map("legal_name")
  tradeName String? @db.VarChar(200) @map("trade_name")
  taxDocument String? @db.VarChar(20) @map("tax_document")
  industry String? @db.VarChar(100)
  contactName String? @db.VarChar(160) @map("contact_name")
  contactEmail String? @db.VarChar(200) @map("contact_email")
  contactPhoneCountryCode String? @db.VarChar(8) @map("contact_phone_country_code")
  contactPhone String? @db.VarChar(40) @map("contact_phone")
  defaultPaymentTermId String? @db.Uuid @map("default_payment_term_id")
  status RecordStatus @default(ACTIVE)
  notes String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  defaultPaymentTerm PaymentTerm? @relation(fields:[defaultPaymentTermId],references:[id],onDelete:SetNull)
  bankAccounts SupplierBankAccount[]
  pixKeys SupplierPixKey[]
  @@index([legalEntityId,taxDocument])
  @@index([legalEntityId,status])
  @@index([legalName])
  @@map("suppliers")
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  legalEntityId String @db.Uuid @map("legal_entity_id")
  name String @db.VarChar(200)
  taxDocument String? @db.VarChar(20) @map("tax_document")
  employmentType String? @db.VarChar(60) @map("employment_type")
  jobTitle String? @db.VarChar(120) @map("job_title")
  costCenterId String? @db.Uuid @map("cost_center_id")
  admissionDate DateTime? @db.Date @map("admission_date")
  bankName String? @db.VarChar(160) @map("bank_name")
  branch String? @db.VarChar(30)
  accountNumber String? @db.VarChar(60) @map("account_number")
  pixKey String? @db.VarChar(255) @map("pix_key")
  status RecordStatus @default(ACTIVE)
  notes String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  @@index([legalEntityId,status])
  @@index([legalEntityId,taxDocument])
  @@index([name])
  @@map("employees")
}
model SupplierBankAccount {
  id String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid @map("supplier_id")
  bankCode String? @db.VarChar(20) @map("bank_code")
  bankName String @db.VarChar(160) @map("bank_name")
  branch String? @db.VarChar(30)
  accountNumber String @db.VarChar(60) @map("account_number")
  accountDigit String? @db.VarChar(10) @map("account_digit")
  holderName String? @db.VarChar(200) @map("holder_name")
  holderDocument String? @db.VarChar(20) @map("holder_document")
  isDefault Boolean @default(false) @map("is_default")
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Cascade)
  @@index([supplierId,status])
  @@map("supplier_bank_accounts")
}
model SupplierPixKey {
  id String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid @map("supplier_id")
  keyType String @db.VarChar(30) @map("key_type")
  keyValue String @db.VarChar(255) @map("key_value")
  isDefault Boolean @default(false) @map("is_default")
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Cascade)
  @@unique([supplierId,keyValue])
  @@index([supplierId,status])
  @@map("supplier_pix_keys")
}
model PayableApprovalPolicy { id String @id @default(uuid()) @db.Uuid legalEntityId String @unique @db.Uuid @map("legal_entity_id") approvalRequiredFrom Decimal @default(0) @db.Decimal(19,4) @map("approval_required_from") updatedBy String @db.Uuid @map("updated_by") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") @@map("payable_approval_policies") }
model PayableDocument { id String @id @default(uuid()) @db.Uuid payableId String @db.Uuid @map("payable_id") documentId String @db.Uuid @map("document_id") type DocumentType? label String? @db.VarChar(160) createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") payable Payable @relation(fields:[payableId],references:[id],onDelete:Cascade) @@unique([payableId,documentId]) @@index([payableId]) @@map("payable_documents") }
model FinancialAccount { id String @id @default(uuid()) @db.Uuid legalEntityId String @db.Uuid @map("legal_entity_id") name String @db.VarChar(160) type FinancialAccountType institutionName String? @db.VarChar(160) @map("institution_name") bankCode String? @db.VarChar(20) @map("bank_code") branch String? @db.VarChar(30) accountNumber String? @db.VarChar(60) @map("account_number") accountDigit String? @db.VarChar(10) @map("account_digit") currency Currency @default(BRL) openingBalance Decimal @db.Decimal(19,4) @map("opening_balance") openingBalanceDate DateTime @db.Date @map("opening_balance_date") status FinancialAccountStatus @default(ACTIVE) allowsReconciliation Boolean @default(true) @map("allows_reconciliation") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") payments Payment[] receipts Receipt[] bankTransactions BankTransaction[] bankStatementImports BankStatementImport[] bankReconciliations BankReconciliation[] outgoingTransfers FinancialTransfer[] @relation("TransferSourceAccount") incomingTransfers FinancialTransfer[] @relation("TransferDestinationAccount") @@index([legalEntityId,status]) @@index([legalEntityId,type]) @@map("financial_accounts") }
model DreGroup { id String @id @default(uuid()) @db.Uuid code String @unique @db.VarChar(40) name String @db.VarChar(180) parentId String? @db.Uuid @map("parent_id") displayOrder Int @default(0) @map("display_order") status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") parent DreGroup? @relation("DreGroupHierarchy",fields:[parentId],references:[id],onDelete:Restrict) children DreGroup[] @relation("DreGroupHierarchy") managementAccounts ManagementAccount[] allocations FinancialClassificationAllocation[] @@index([parentId]) @@index([status,displayOrder]) @@map("dre_groups") }
model CashFlowGroup { id String @id @default(uuid()) @db.Uuid code String @unique @db.VarChar(40) name String @db.VarChar(180) parentId String? @db.Uuid @map("parent_id") displayOrder Int @default(0) @map("display_order") status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") parent CashFlowGroup? @relation("CashFlowGroupHierarchy",fields:[parentId],references:[id],onDelete:Restrict) children CashFlowGroup[] @relation("CashFlowGroupHierarchy") managementAccounts ManagementAccount[] allocations FinancialClassificationAllocation[] @@index([parentId]) @@index([status,displayOrder]) @@map("cash_flow_groups") }
model ManagementAccount { id String @id @default(uuid()) @db.Uuid code String @unique @db.VarChar(40) name String @db.VarChar(180) parentId String? @db.Uuid @map("parent_id") nature ManagementAccountNature economicNature EconomicNature @map("economic_nature") defaultCostBehavior CostBehavior @default(NOT_APPLICABLE) @map("default_cost_behavior") defaultCostDirectness CostDirectness @default(NOT_APPLICABLE) @map("default_cost_directness") dreGroupId String? @db.Uuid @map("dre_group_id") cashFlowGroupId String? @db.Uuid @map("cash_flow_group_id") allowsPosting Boolean @default(true) @map("allows_posting") status RecordStatus @default(ACTIVE) validFrom DateTime? @db.Date @map("valid_from") validUntil DateTime? @db.Date @map("valid_until") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") parent ManagementAccount? @relation("ManagementAccountHierarchy",fields:[parentId],references:[id],onDelete:Restrict) children ManagementAccount[] @relation("ManagementAccountHierarchy") dreGroup DreGroup? @relation(fields:[dreGroupId],references:[id],onDelete:Restrict) cashFlowGroup CashFlowGroup? @relation(fields:[cashFlowGroupId],references:[id],onDelete:Restrict) allocations FinancialClassificationAllocation[] @@index([parentId]) @@index([economicNature,status]) @@index([dreGroupId]) @@index([cashFlowGroupId]) @@map("management_accounts") }
model CostCenter { id String @id @default(uuid()) @db.Uuid code String @unique @db.VarChar(40) name String @db.VarChar(180) parentId String? @db.Uuid @map("parent_id") managerId String? @db.Uuid @map("manager_id") status RecordStatus @default(ACTIVE) validFrom DateTime? @db.Date @map("valid_from") validUntil DateTime? @db.Date @map("valid_until") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") parent CostCenter? @relation("CostCenterHierarchy",fields:[parentId],references:[id],onDelete:Restrict) children CostCenter[] @relation("CostCenterHierarchy") allocations FinancialClassificationAllocation[] @@index([parentId]) @@index([status]) @@map("cost_centers") }
model BusinessLine { id String @id @default(uuid()) @db.Uuid code String @unique @db.VarChar(40) name String @db.VarChar(180) parentId String? @db.Uuid @map("parent_id") status RecordStatus @default(ACTIVE) validFrom DateTime? @db.Date @map("valid_from") validUntil DateTime? @db.Date @map("valid_until") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") parent BusinessLine? @relation("BusinessLineHierarchy",fields:[parentId],references:[id],onDelete:Restrict) children BusinessLine[] @relation("BusinessLineHierarchy") allocations FinancialClassificationAllocation[] @@index([parentId]) @@index([status]) @@map("business_lines") }
model FinancialPeriod { id String @id @default(uuid()) @db.Uuid legalEntityId String @db.Uuid @map("legal_entity_id") year Int month Int startDate DateTime @db.Date @map("start_date") endDate DateTime @db.Date @map("end_date") status FinancialPeriodStatus @default(OPEN) closedBy String? @db.Uuid @map("closed_by") closedAt DateTime? @db.Timestamptz(6) @map("closed_at") reopenedBy String? @db.Uuid @map("reopened_by") reopenedAt DateTime? @db.Timestamptz(6) @map("reopened_at") reopeningReason String? @db.Text @map("reopening_reason") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") @@unique([legalEntityId,year,month]) @@index([legalEntityId,status]) @@map("financial_periods") }
model Payable { id String @id @default(uuid()) @db.Uuid legalEntityId String @db.Uuid @map("legal_entity_id") counterpartyId String @db.Uuid @map("counterparty_id") counterpartyType CounterpartyType @map("counterparty_type") obligationType PayableObligationType? @map("obligation_type") description String @db.Text documentNumber String? @db.VarChar(100) @map("document_number") documentType DocumentType? @map("document_type") issueDate DateTime? @db.Date @map("issue_date") competenceDate DateTime @db.Date @map("competence_date") originalAmount Decimal @db.Decimal(19,4) @map("original_amount") currency Currency @default(BRL) status PayableStatus @default(DRAFT) sourceType PayableSourceType @map("source_type") sourceId String? @db.Uuid @map("source_id") contractId String? @db.Uuid @map("contract_id") purchaseOrderId String? @db.Uuid @map("purchase_order_id") paymentTermId String? @db.Uuid @map("payment_term_id") createdBy String @db.Uuid @map("created_by") createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at") updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at") version Int @default(1) installments PayableInstallment[] allocations FinancialClassificationAllocation[] documents PayableDocument[] approvals PayableApproval[] paymentTerm PaymentTerm? @relation(fields:[paymentTermId],references:[id],onDelete:SetNull) @@index([legalEntityId,status]) @@index([counterpartyId,status]) @@index([competenceDate]) @@index([documentNumber]) @@index([contractId]) @@index([purchaseOrderId]) @@map("payables") }
