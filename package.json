{
  "name": "aritech-plataform",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma Aritech — monorepo (Next.js + NestJS + PostgreSQL/Prisma)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @aritech/database generate",
    "db:migrate": "pnpm --filter @aritech/database migrate:dev",
    "db:seed": "pnpm --filter @aritech/database seed",
    "db:studio": "pnpm --filter @aritech/database studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
